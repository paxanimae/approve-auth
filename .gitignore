# Go
/bin/
*.test
*.out
coverage.*
/.gocache/

# Node / web
web/admin/node_modules/
web/admin/dist/
web/admin/.svelte-kit/

# Local dev secrets and generated TLS material — never commit.
# (Fixture certs/keys under */testdata/ are deliberately NOT covered by a
# blanket *.pem/*.key rule, since those are real, tracked test inputs.)
deploy/dev/certs/
deploy/dev/secrets/
deploy/dev/mtls/

# Downloaded GeoIP database -- fetched by scripts/fetch-geoip.sh, never
# bundled/shipped by this repo (see that script's own header comment).
deploy/dev/geoip/

# Helm dependency archives -- regenerated from Chart.lock by
# `helm dependency build`, never committed (standard Helm convention).
deploy/helm/*/charts/

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Env
.env
.env.*
