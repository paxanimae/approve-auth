{{define "request.html.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Request access</title>
  <link rel="stylesheet" href="/__approve-auth/assets/tokens.css" />
  <script src="/__approve-auth/assets/app.js" defer></script>
</head>
<body>
  <main>
    <div class="brand">
      <img src="/__approve-auth/assets/logo.svg" alt="" />
      <span>Approve</span>
    </div>
    <h1>Request access to {{.DisplayName}}</h1>
    <p class="hostname">{{.Hostname}}</p>
    <form id="request-form" method="post" action="/__approve-auth/requests">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}" />
      <input type="hidden" name="return_to" value="{{.ReturnTo}}" />
      <div class="field">
        <label for="label">Device label (optional)</label>
        <input type="text" id="label" name="label" maxlength="100" />
      </div>
      <div class="field">
        <label for="message">Message to the administrator (optional)</label>
        <textarea id="message" name="message" maxlength="500" rows="3"></textarea>
      </div>
      <button type="submit" class="btn-primary">Request access</button>
    </form>
    <p class="auto-notice" id="auto-notice" aria-live="polite"></p>
  </main>
</body>
</html>
{{end}}
