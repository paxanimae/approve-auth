{{define "waiting.html.tmpl"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="refresh" content="15" />
  <title>Access status</title>
  <link rel="stylesheet" href="/__approve-auth/assets/tokens.css" />
  <script src="/__approve-auth/assets/app.js" defer></script>
</head>
<body data-state="{{.State}}" data-csrf-token="{{.CSRFToken}}">
  <main>
    <div class="brand">
      <img src="/__approve-auth/assets/logo.svg" alt="" />
      <span>Approve</span>
    </div>
    <p id="reconnecting-notice" role="status" hidden>Reconnecting&hellip;</p>

    {{if eq .State "pending"}}
      <h1>Waiting for approval</h1>
      <p class="verification-code">{{.VerificationCode}}</p>
      <p class="hostname">Show this code to your administrator so they can confirm it's you.</p>
      {{if .ApproveQRCodeSVG}}
        <div class="approve-qr">
          <p class="approve-qr-label">Or, if you have approval rights: scan to review and approve</p>
          {{.ApproveQRCodeSVG}}
        </div>
      {{end}}
      <form method="post" action="/__approve-auth/cancel">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}" />
        <button type="submit">Cancel request</button>
      </form>
    {{else if eq .State "approved"}}
      <h1>Approved</h1>
      <p class="verification-code">{{.VerificationCode}}</p>
      <form method="post" action="/__approve-auth/claim">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}" />
        <button type="submit" class="btn-primary">Continue</button>
      </form>
    {{else if eq .State "claimed"}}
      {{if .HasAccessCookie}}
        <h1>Ready</h1>
        <form method="post" action="/__approve-auth/ack">
          <button type="submit" class="btn-primary">Open application</button>
        </form>
      {{else}}
        <h1>Almost there</h1>
        <p class="hostname">Please refresh this page.</p>
      {{end}}
    {{else if eq .State "denied"}}
      <h1>Request denied</h1>
      {{if .PublicMessage}}<p class="public-message">{{.PublicMessage}}</p>{{end}}
      <p class="hostname">You may request access again.</p>
      <p><a class="btn-primary" href="/__approve-auth/request">Request access</a></p>
    {{else if eq .State "canceled"}}
      <h1>Request canceled</h1>
      <p><a class="btn-primary" href="/__approve-auth/request">Request access</a></p>
    {{else if eq .State "timed_out"}}
      <h1>Request timed out</h1>
      <p><a class="btn-primary" href="/__approve-auth/request">Request access</a></p>
    {{else if eq .State "claim_expired"}}
      <h1>Approval window expired</h1>
      <p><a class="btn-primary" href="/__approve-auth/request">Request access</a></p>
    {{else}}
      <h1>No pending request</h1>
      <p><a class="btn-primary" href="/__approve-auth/request">Request access</a></p>
    {{end}}
    <p><a href="/__approve-auth/waiting">Refresh</a></p>
  </main>
</body>
</html>
{{end}}
